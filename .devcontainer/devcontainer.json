{
  "name": "my-homepage",
  "dockerComposeFile": "./compose.yaml",
  "service": "astro-web",
  "workspaceFolder": "/service/web/my-homepage",
  // claude-code feature が root でインストールされる際に /home/node/.npm へ root 所有のファイルを作ってしまうため、npm install 前に所有権を戻す
  "postCreateCommand": "sudo chown -R 1000:1000 /home/node/.npm 2>/dev/null; npm install && npx playwright install --with-deps && (node -v | sed 's/^.\\{1\\}//' > .node-version)", // `.node-version`を開発コンテナに合わせて自動更新
  "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && git config --global core.editor vim",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind"
  ],
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.tabSize": 2,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true,
        "biome.lspBin": "node_modules/@biomejs/biome/bin/biome",
        "[javascript][javascriptreact][typescript][typescriptreact][astro]": {
          "editor.defaultFormatter": "biomejs.biome",
          "editor.codeActionsOnSave": {
            "quickfix.biome": "explicit"
          },
          "editor.formatOnSave": true
        }
      },
      "extensions": [
        "ms-ceintl.vscode-language-pack-ja",
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "emranweb.daisyui-snippet",
        "biomejs.biome",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker",
        "GitHub.vscode-pull-request-github",
        "Anthropic.claude-code"
      ]
    }
  }
}
